# SafarX Environment Configuration

# Backend Spring Boot Base URL (e.g. http://localhost:8080)
# WebSocket URL is automatically derived from this (http -> ws, https -> wss)
VITE_API_URL=http://localhost:8080

# Razorpay Key ID for Online Rider Payments
VITE_RAZORPAY_KEY_ID=

# Demo Mode: when true, test drivers are colocated at Hyderabad Hub for easy multi-tab wave testing
# Set to false for actual real device GPS navigation via navigator.geolocation.watchPosition
VITE_DEMO_MODE=true
